---
import '../styles/global.css';
import { site } from '../config/site';
import SiteFooter from '../components/shared/SiteFooter.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { breadcrumbSchema, organizationSchema, webPageSchema, webSiteSchema } from '../utils/schema';

interface Props {
  title?: string;
  description?: string;
  serviceTitle?: string;
  /** URL gambar untuk meta Open Graph (og:image). Kosong = fallback logo. */
  socialImage?: string;
  /** URL kanonik; kosong = mengikuti URL permintaan. */
  canonical?: string;
  /** Jika true, halaman tidak diindeks oleh mesin pencari. */
  noindex?: boolean;
  /** Tanggal terbit dokumen — dipakai datePublished WebPage. */
  pubDate?: Date;
  /** Tanggal pembaruan dokumen — dipakai dateModified WebPage. */
  updatedDate?: Date;
  /** @id tipe utama halaman (mis. `${url}#article`) — dirujuk WebPage.mainEntity. */
  mainEntityId?: string;
  /** Node schema.org tambahan per halaman (Service/Article/FAQPage/ItemList). */
  jsonLd?: Record<string, unknown>[];
}
const {
  title,
  description = 'Informasi dan pendampingan kebutuhan SLO dan NIDI.',
  serviceTitle,
  socialImage,
  canonical,
  noindex = false,
  pubDate,
  updatedDate,
  mainEntityId,
  jsonLd,
} = Astro.props;
const fullTitle = title ? title + ' | ' + site.name : site.name;
const ogImage = socialImage || '/images/logo-jasa-slo.svg';
const canonicalUrl = canonical || Astro.url.href;
const robots = noindex ? 'noindex, nofollow' : 'index, follow';
// Node yang selalu ada di setiap halaman: Organization + WebSite (sitewide),
// WebPage halaman berjalan (…#webpage), dan BreadcrumbList dari pathname.
const base = Astro.site?.href ?? Astro.url.origin;
const siteNodes = [
  organizationSchema(base),
  webSiteSchema(base),
  webPageSchema({
    base,
    url: canonicalUrl,
    title: title ?? site.name,
    description,
    datePublished: pubDate,
    dateModified: updatedDate,
    mainEntityId,
  }),
  breadcrumbSchema(base, Astro.url.pathname, title),
];
---
<!doctype html>
<html lang="id">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
<title>{fullTitle}</title><meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonicalUrl} />
<meta name="theme-color" content="#2a1a0e" />
<link rel="apple-touch-icon" href="/images/logo-jasa-slo@2x.png" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:type" content="website" />
<meta property="og:locale" content="id_ID" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<JsonLd data={siteNodes} />
{jsonLd && jsonLd.length > 0 && <JsonLd data={jsonLd} />}
</head>
<body class="min-h-screen"><slot /><SiteFooter serviceTitle={serviceTitle} /></body>
</html>
