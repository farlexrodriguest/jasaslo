---
const { id, text, source, class: css } = Astro.props;
---
<blockquote id={id} class={`relative rounded-2xl border-l-4 border-[#d4621a] bg-[#fffaf2] p-6 italic text-[#594332] ${css?.section ?? ''}`}>
  <p class={`text-lg leading-relaxed ${css?.text ?? ''}`}>"{text}"</p>
  {source && <cite class={`mt-3 block not-italic text-sm font-semibold text-[#624b39] ${css?.source ?? ''}`}>— {source}</cite>}
</blockquote>
