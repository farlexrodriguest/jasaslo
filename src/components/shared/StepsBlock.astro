---
const { id, heading, items, class: css } = Astro.props;
---
<section id={id} class={`rounded-2xl border border-[#dfcdb8] bg-[#fffaf2] p-6 md:p-8 ${css?.section ?? ''}`}>
  {heading && <h2 class={`mb-6 text-2xl font-extrabold text-[#2a1a0e] ${css?.heading ?? ''}`}>{heading}</h2>}
  <ol class={`space-y-6 ${css?.list ?? ''}`}>
    {items.map((item: any, i: number) => (
      <li class={`flex gap-4 ${css?.item ?? ''}`}>
        <span class={`flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-[#d4621a] text-sm font-bold text-white ${css?.badge ?? ''}`}>{i + 1}</span>
        <div>
          <p class={`font-semibold text-[#2a1a0e] ${css?.title ?? ''}`}>{item.title}</p>
          <p class={`mt-1 text-sm leading-relaxed text-[#624b39] ${css?.text ?? ''}`}>{item.text}</p>
        </div>
      </li>
    ))}
  </ol>
</section>
