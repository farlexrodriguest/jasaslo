---
/**
 * ChecklistCard — checklist with checkmarks, optional details and required badges.
 *
 * Props:
 * - id: string — anchor id
 * - title: string — section title
 * - description?: string — optional description
 * - items: Array<{label, detail?, required?}> — checklist items
 * - note?: string — optional note at bottom
 *
 * Usage:
 * <ChecklistCard id="checklist" title="Persyaratan Dokumen" items={[{label: "KTP", detail: "Foto copy", required: true}]} />
 */
import { ui } from '../../config/ui.ts';
const { id, title, description, items, note } = Astro.props;
---
<section id={id} class="my-10 border border-[#dfcdb8] bg-[#fffaf2] p-6 sm:p-9" aria-labelledby={`${id}-title`}>
  <div class="mb-5 flex items-start gap-3">
    <span class="flex h-10 w-10 shrink-0 items-center justify-center bg-[#f4ae52] text-lg text-[#2a1a0e]" aria-hidden="true">✓</span>
    <div>
      <h2 id={`${id}-title`} class="text-xl font-extrabold text-[#2a1a0e] sm:text-2xl">{title}</h2>
      {description && <p class="mt-2 leading-7 text-[#624b39]">{description}</p>}
    </div>
  </div>
  <ul class="divide-y divide-[#dfcdb8]">
    {items.map((item: {label: string; detail?: string; required?: boolean}) => (
      <li class="flex gap-3 py-4">
        <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded border border-[#d4621a] text-xs text-[#a34a17]" aria-hidden="true">✓</span>
        <div class="flex-1">
          <p class="font-semibold text-[#2a1a0e]">{item.label}</p>
          {item.detail && <p class="mt-1 text-sm leading-6 text-[#624b39]">{item.detail}</p>}
        </div>
        {item.required && <span class="shrink-0 text-xs font-semibold text-[#a34a17]">{ui.blocks.checklistRequiredLabel}</span>}
      </li>
    ))}
  </ul>
  {note && <p class="mt-4 bg-[#fef3e2] p-4 text-sm leading-6 text-[#624b39]">{note}</p>}
</section>