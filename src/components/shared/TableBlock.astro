---
const { id, heading, head, rows, class: css } = Astro.props;
---
<section id={id} class={`rounded-2xl border border-[#dfcdb8] bg-white p-6 md:p-8 ${css?.section ?? ''}`}>
  {heading && <h2 class={`mb-4 text-2xl font-extrabold text-[#2a1a0e] ${css?.heading ?? ''}`}>{heading}</h2>}
  <div class={`overflow-x-auto rounded-xl border border-[#dfcdb8] ${css?.wrapper ?? ''}`}>
    <table class={`w-full text-left text-sm ${css?.table ?? ''}`}>
      <thead>
        <tr class={`border-b border-[#dfcdb8] bg-[#fffaf2] ${css?.row ?? ''}`}>
          {head.map((h: string) => <th class={`px-4 py-3 font-semibold text-[#2a1a0e] ${css?.th ?? ''}`}>{h}</th>)}
        </tr>
      </thead>
      <tbody>
        {rows.map((row: string[], i: number) => (
          <tr class={`border-b border-[#fffaf2] last:border-0 ${i % 2 === 1 ? 'bg-[#fffaf2]/50' : ''} ${css?.row ?? ''}`}>
            {row.map((cell: string) => <td class={`px-4 py-3 text-[#594332] ${css?.td ?? ''}`}>{cell}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
