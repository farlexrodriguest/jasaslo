---
import { ui } from '../../config/ui.ts';
const { id, variant = 'info', title, text, class: css } = Astro.props;
const variants: Record<string, string> = {
  info: 'border-[#dfcdb8] bg-[#fef3e2] text-[#2a1a0e]',
  success: 'border-[#dfcdb8] bg-[#fef3e2] text-[#2a1a0e]',
  warning: 'border-[#d4621a] bg-[#f4ae52] text-[#2a1a0e]',
  danger: 'border-[#d4621a] bg-[#fef3e2] text-[#2a1a0e]',
};
const variantClass = variants[variant];
---
<section id={id} class={`border-l-4 px-6 py-5 ${variantClass} ${css?.section ?? ''}`}>
  {(title || text) && <h4 class={`font-semibold ${css?.title ?? ''}`}>{title ?? ui.blocks.noteDefaultTitles[variant] ?? variant}</h4>}
  {text && <p class={`mt-1 text-sm leading-relaxed ${css?.text ?? ''}`}>{text}</p>}
</section>
