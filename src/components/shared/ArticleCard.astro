---
/**
 * ArticleCard — article summary card for article listings.
 *
 * Props:
 * - article: CollectionEntry<'articles'> — article data from content collection
 * - headingLevel?: 2 | 3 — heading tag for the title (default 3; use 2 when the card sits directly under the page h1)
 *
 * Usage:
 * <ArticleCard article={article} />
 */
import { ui } from '../../config/ui.ts';
const { article, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const utcIso = (date: Date) => date.toISOString().replace(/\.\d{3}Z$/, 'Z');
const href = `/artikel/${article.data.slug}/`;
---
<article class="flex h-full flex-col rounded-2xl border border-[#dfcdb8] bg-white p-6 transition hover:-translate-y-1 hover:border-[#dfcdb8] hover:shadow-lg">
  {article.data.image && <div class="article-card__media overflow-hidden rounded-xl"><img src={article.data.image} alt="" class="h-40 w-full object-cover" loading="lazy" decoding="async" /></div>}
  {article.data.category && <p class="mt-4 text-xs font-bold uppercase tracking-wider text-[#d4621a]">{article.data.category}</p>}
  <Heading class="mt-3 text-lg font-bold leading-snug text-[#2a1a0e]"><a href={href} class="hover:text-[#d4621a]">{article.data.title}</a></Heading>
  <p class="mt-3 flex-1 text-sm leading-6 text-[#624b39]">{article.data.description}</p>
  <div class="mt-5 flex items-center justify-between text-xs text-[#624b39]"><time datetime={utcIso(article.data.pubDate)}>{article.data.pubDate.toLocaleDateString(ui.locale, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Jakarta' })}</time><a href={href} class="font-semibold text-[#d4621a]">{ui.article.readMore}</a></div>
</article>