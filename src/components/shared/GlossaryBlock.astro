---
const { id, heading, items, class: css } = Astro.props;
---
<section id={id} class={`rounded-2xl border border-[#dfcdb8] bg-white p-6 md:p-8 ${css?.section ?? ''}`}>
  {heading && <h2 class={`mb-6 text-2xl font-extrabold text-[#2a1a0e] ${css?.heading ?? ''}`}>{heading}</h2>}
  <dl class={`space-y-4 ${css?.list ?? ''}`}>
    {items.map((item: any) => (
      <div class={`border-b border-[#fffaf2] pb-3 last:border-0 ${css?.item ?? ''}`}>
        <dt class={`font-semibold text-[#2a1a0e] ${css?.term ?? ''}`}>{item.term}</dt>
        <dd class={`mt-1 text-sm leading-relaxed text-[#624b39] ${css?.definition ?? ''}`}>{item.definition}</dd>
      </div>
    ))}
  </dl>
</section>
