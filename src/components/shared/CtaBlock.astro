---
import { site } from '../../config/site.ts';
const { id, heading, message, buttonText, class: css } = Astro.props;
const waRaw = site.contact?.whatsapp || site.whatsapp || '';
const cleanWhatsApp = waRaw.replace(/\D/g, '');
const hasWhatsapp = /^\d{8,15}$/.test(cleanWhatsApp);
const href = hasWhatsapp ? `https://wa.me/${cleanWhatsApp}?text=${encodeURIComponent(message)}` : undefined;
---
<section id={id} class={`rounded-2xl border border-[#dfcdb8] bg-[#fffaf2] p-6 md:p-8 ${css?.section ?? ''}`}>
  {heading && <h2 class={`mb-2 text-xl font-bold text-[#2a1a0e] ${css?.heading ?? ''}`}>{heading}</h2>}
  <p class={`mb-5 text-[#594332] ${css?.message ?? ''}`}>{message}</p>
  {href ? (
    <a href={href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-lg bg-[#d4621a] px-5 py-2.5 font-semibold text-white transition hover:bg-[#b8500f]">{buttonText || 'Konsultasi Sekarang'}</a>
  ) : (
    <p class="text-sm text-[#624b39]">Nomor WhatsApp tidak valid atau tidak terisi</p>
  )}
</section>
