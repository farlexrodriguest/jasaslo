---
import { getCollection } from 'astro:content';
import ArticleCard from './ArticleCard.astro';
import { ui } from '../../config/ui.ts';
const { id, heading, description, mode = 'listing', limit = 0, offset = 0 } = Astro.props;
const allArticles = (await getCollection('articles'))
  .filter((article) => !article.data.draft)
  .sort((a, b) => b.data.updatedDate.valueOf() - a.data.updatedDate.valueOf() || b.data.id - a.data.id);
const articles = allArticles.slice(Math.max(0, offset), limit > 0 ? Math.max(0, offset) + limit : undefined);
---
<section id={id} class={mode === 'latest' ? 'mx-auto max-w-7xl px-5 py-16' : 'mt-10'}>
  {mode === 'latest' ? <div class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end"><div><p class="text-sm font-bold uppercase tracking-wider text-[#d4621a]">{ui.article.latestEyebrow}</p><h2 class="mt-2 text-3xl font-extrabold tracking-tight text-[#2a1a0e]">{heading}</h2><p class="mt-3 max-w-2xl text-[#624b39]">{description}</p></div><a href="/artikel/" class="font-semibold text-[#d4621a] hover:text-[#2a1a0e]">{ui.article.allArticlesLink}</a></div> : <div class="max-w-3xl"><h2 class="text-2xl font-black tracking-tight text-[#2a1a0e]">{heading}</h2>{description && <p class="mt-3 leading-7 text-[#624b39]">{description}</p>}</div>}
  {articles.length ? <div class={mode === 'latest' ? 'grid gap-5 md:grid-cols-3' : 'mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3'}>{articles.map((article) => <ArticleCard article={article} headingLevel={mode === 'latest' ? 3 : 2} />)}</div> : <p class="mt-6 rounded-xl border border-dashed border-[#dfcdb8] p-8 text-[#624b39]">{ui.article.emptyList}</p>}
</section>
