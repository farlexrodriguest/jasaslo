---
/**
 * HomeProcessBlock — bagian pendekatan pada beranda (ber-brand, latar espresso).
 *
 * Props:
 * - id?, eyebrow?, heading, headingHighlight?
 * - steps: Array<{ number, title }>
 */
const { id = 'pendekatan', eyebrow, heading, headingHighlight, steps = [] } = Astro.props as {
  id?: string;
  eyebrow?: string;
  heading: string;
  headingHighlight?: string;
  steps: Array<{ number: string; title: string }>;
};
---
<section id={id} class="bg-[#2a1a0e] px-6 py-20 text-[#fef3e2] lg:px-12 lg:py-28">
  <div class="mx-auto grid max-w-[1344px] gap-10 md:grid-cols-[.7fr_1.3fr]">
    <p class="eyebrow text-[#f4ae52]">{eyebrow}</p>
    <div>
      <h2 class="text-4xl font-extrabold leading-tight md:text-6xl">{heading} {headingHighlight && <span class="text-[#f4ae52]">{headingHighlight}</span>}</h2>
      <div class="mt-12 grid gap-8 border-t border-[#73513c] pt-8 sm:grid-cols-3">
        {steps.map((step) => (<div><span class="eyebrow text-[#f4ae52]">{step.number}</span><p class="mt-3 text-xl font-semibold">{step.title}</p></div>))}
      </div>
    </div>
  </div>
</section>
