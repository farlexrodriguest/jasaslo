---
const { id, heading, items, class: css } = Astro.props;
---
<section id={id} class={`border border-[#dfcdb8] bg-[#fffaf2] p-6 md:p-8 ${css?.section ?? ''}`}>
  {heading && <h2 class={`mb-6 text-2xl font-extrabold text-[#2a1a0e] ${css?.heading ?? ''}`}>{heading}</h2>}
  <div class={`space-y-3 ${css?.list ?? ''}`}>
    {items.map((item: any) => (
      <details class={`group border-b border-[#dfcdb8] p-4 transition ${css?.item ?? ''}`}>
        <summary class={`flex cursor-pointer list-none items-center justify-between font-semibold text-[#2a1a0e] ${css?.summary ?? ''}`}>
          {item.question}
          <span class={`ml-4 flex-shrink-0 text-[#a34a17] transition-transform group-open:rotate-180 ${css?.chevron ?? ''}`}>
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </span>
        </summary>
        <p class={`mt-3 text-sm leading-relaxed text-[#624b39] ${css?.answer ?? ''}`}>{item.answer}</p>
      </details>
    ))}
  </div>
</section>
