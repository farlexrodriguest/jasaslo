---
/**
 * NotFoundBlock — halaman tidak ditemukan (404) ber-brand.
 *
 * Blok ini terdaftar di `blocks.ts` (kunci `not-found`) dan di-render oleh
 * `src/404.astro`. Warna mengikuti palet espresso/cream, bukan slate/blue
 * bawaan contoh.
 */
const { eyebrow, heading, message, image, homeCta, servicesCta, articlesCta } = Astro.props;
---
<div class="mx-auto flex min-h-[60vh] max-w-3xl flex-col items-center justify-center px-5 py-20 text-center">
  <img src={image} alt="" aria-hidden="true" class="mb-8 w-full max-w-xs" width="560" height="360" />
  <p class="text-sm font-extrabold uppercase tracking-[0.16em] text-[#a34a17]">{eyebrow}</p>
  <h1 class="mt-3 text-4xl font-black tracking-tight text-[#2a1a0e] sm:text-5xl">{heading}</h1>
  <p class="mt-5 max-w-xl leading-7 text-[#624b39]">{message}</p>
  <div class="mt-8 flex flex-col gap-3 sm:flex-row">
    <a href="/" class="inline-flex items-center justify-center rounded-lg bg-[#2a1a0e] px-6 py-3 font-bold text-[#fef3e2] no-underline hover:bg-[#5b3420] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#a34a17]">{homeCta}</a>
    <a href="/layanan/" class="inline-flex items-center justify-center rounded-lg border border-[#dfcdb8] px-6 py-3 font-bold text-[#2a1a0e] no-underline hover:bg-[#f3ead7] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#a34a17]">{servicesCta}</a>
    <a href="/artikel/" class="inline-flex items-center justify-center rounded-lg border border-[#dfcdb8] px-6 py-3 font-bold text-[#2a1a0e] no-underline hover:bg-[#f3ead7] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#a34a17]">{articlesCta}</a>
  </div>
</div>