---
import type { CollectionEntry } from 'astro:content';

const { article, articles = [], limit = 5 } = Astro.props as {
  article: CollectionEntry<'articles'>;
  articles: CollectionEntry<'articles'>[];
  limit?: number;
};

const previousArticles = articles
  .filter((item) => !item.data.draft && item.data.id < article.data.id)
  .sort((a, b) => b.data.id - a.data.id)
  .slice(0, limit);
---
{previousArticles.length > 0 && (
  <section class="mt-8 border-t border-[#dfcdb8] pt-5" aria-labelledby="previous-articles-heading">
    <h2 id="previous-articles-heading" class="mb-3 text-xs font-bold uppercase tracking-wider text-[#624b39]">
      Artikel sebelumnya
    </h2>
    <ol class="space-y-3">
      {previousArticles.map((item) => (
        <li class="border-l-2 border-[#dfcdb8] pl-3 transition-colors hover:border-[#d4621a]">
          <a
            href={`/artikel/${item.data.slug}/`}
            class="text-sm font-semibold leading-5 text-[#594332] no-underline hover:text-[#d4621a]"
          >
            {item.data.title}
          </a>
          {item.data.category && (
            <p class="mt-1 text-xs text-[#624b39]">{item.data.category}</p>
          )}
        </li>
      ))}
    </ol>
  </section>
)}
