---
import { navigation } from '../../config/navigation';
import { site } from '../../config/site.ts';
---
<header class="border-b border-[#dfcdb8] bg-[#fef3e2]">
  <div class="mx-auto flex max-w-[1440px] flex-wrap items-center justify-between gap-5 px-6 py-5 lg:px-12">
    <a href="/" aria-label={`${site.name} — Beranda`}><img src="/images/logo-jasa-slo.svg" alt={site.name} width="621" height="110" class="h-9 w-auto" /></a>
    <nav aria-label="Navigasi utama" class="order-3 flex w-full flex-wrap gap-x-6 gap-y-2 text-sm font-semibold md:order-none md:w-auto">
      {navigation.header.map((item) => <a href={item.href} class="hover:text-[#d4621a]">{item.label}</a>)}
    </nav>
    <a href={navigation.cta.href} class="border border-[#2a1a0e] px-5 py-2.5 text-sm font-bold transition hover:bg-[#2a1a0e] hover:text-[#fef3e2]">{navigation.cta.label} ↗</a>
  </div>
</header>
