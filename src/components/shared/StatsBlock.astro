---
const { id, heading, items, class: css } = Astro.props;
---
<section id={id} class={`rounded-2xl border border-[#dfcdb8] bg-white p-6 md:p-8 ${css?.section ?? ''}`}>
  {heading && <h2 class={`mb-6 text-2xl font-extrabold text-[#2a1a0e] ${css?.heading ?? ''}`}>{heading}</h2>}
  <div class={`grid gap-6 sm:grid-cols-2 ${css?.grid ?? ''}`}>
    {items.map((item: any) => (
      <div class={`rounded-xl border border-[#fffaf2] bg-[#fffaf2] p-5 text-center ${css?.item ?? ''}`}>
        <p class={`text-3xl font-extrabold text-[#d4621a] ${css?.value ?? ''}`}>{item.value}</p>
        <p class={`mt-1 text-sm text-[#624b39] ${css?.label ?? ''}`}>{item.label}</p>
      </div>
    ))}
  </div>
</section>
