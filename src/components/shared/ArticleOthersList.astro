---
import { getCollection } from 'astro:content';

interface Props {
  excludeSlug: string;
}

const { excludeSlug } = Astro.props;

const allArticles = await getCollection('articles');
const others = allArticles
  .filter(a => !a.data.draft && a.data.slug !== excludeSlug)
  .sort((a, b) => b.data.updatedDate.valueOf() - a.data.updatedDate.valueOf());
---

{others.length > 0 && (
  <nav class="space-y-8">
    <div class="space-y-4">
      <p class="eyebrow text-[#a34a17]">Artikel Lainnya</p>
      <ul class="divide-y divide-[#dfcdb8] border-t border-[#dfcdb8]">
        {others.map(a => (
          <li>
            <a href={`/artikel/${a.data.slug}/`} class="group block py-5">
              <h3 class="text-sm font-bold uppercase tracking-tight text-[#2a1a0e] group-hover:text-[#d4621a] transition-colors">
                {a.data.title}
              </h3>
              <p class="mt-1 text-xs leading-5 text-[#624b39] line-clamp-2 transition-colors group-hover:text-[#2a1a0e]">
                {a.data.description}
              </p>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <a href="/artikel/" class="inline-block text-xs font-bold uppercase tracking-widest text-[#a34a17] hover:text-[#d4621a] transition-colors">
      Lihat semua artikel →
    </a>
  </nav>
)}
