---
/**
 * FeatureCardGrid — grid of feature cards with checkmark points.
 *
 * Props:
 * - id: string — anchor id
 * - title: string — section title
 * - columns: 2 | 3 — grid columns (default 3)
 * - items: Array<{title, description?, points?}> — feature items
 *
 * Usage:
 * <FeatureCardGrid id="features" title="Manfaat Layanan" columns={3} items={[{title: "Cepat", points: ["1-2 minggu", "Dokumen lengkap"]}]} />
 */
const { id, title, columns = 3, items } = Astro.props as { id: string; title: string; columns?: 2 | 3; items: {title: string; description?: string; points?: string[]}[] };
const titleId = `${id}-title`;
const gridClass = columns === 2 ? 'md:grid-cols-2' : 'sm:grid-cols-2 lg:grid-cols-3';
---
<section id={id} class="py-16 bg-[#fffaf2]" aria-labelledby={titleId}>
  <div class="mx-auto max-w-3xl px-6">
    <h2 id={titleId} class="text-2xl font-bold text-center text-[#2a1a0e] mb-12">{title}</h2>
    <div class="grid gap-8 md:grid-cols-2">
      {items.map((item: {title: string; description?: string; points?: string[]}) => (
        <article class="bg-white p-8 rounded-xl shadow-sm border border-[#dfcdb8]">
          <h3 class="text-xl font-bold text-[#2a1a0e] mb-4 text-[#d4621a]">{item.title}</h3>
          {item.description && <p class="text-[#624b39] leading-relaxed">{item.description}</p>}
          {item.points && (
            <ul class="space-y-3 text-[#624b39]">
              {item.points.map((point: string) => <li class="flex items-start"><span class="text-[#d4621a] font-bold mr-2" aria-hidden="true">✓</span><span>{point}</span></li>)}
            </ul>
          )}
        </article>
      ))}
    </div>
  </div>
</section>