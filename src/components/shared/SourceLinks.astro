---
const { id, title, intro, items } = Astro.props;
---
<section id={id} class="mt-8 scroll-mt-24 rounded-2xl border border-[#dfcdb8] bg-[#fffaf2] p-6">
  <h2 id={`${id}-title`} class="text-xl font-extrabold tracking-tight text-[#2a1a0e]">{title}</h2>
  {intro && <p class="mt-3 text-sm leading-7 text-[#594332]">{intro}</p>}
  <ul class="mt-4 space-y-4">
    {items.map((item: { label: string; url: string; description?: string }) => (
      <li>
        <a href={item.url} target="_blank" rel="noopener noreferrer" class="font-semibold text-[#2a1a0e] underline decoration-[#d4621a] underline-offset-4 hover:text-[#b8500f]">
          {item.label}
        </a>
        {item.description && <p class="mt-1 text-sm leading-6 text-[#624b39]">{item.description}</p>}
      </li>
    ))}
  </ul>
</section>
