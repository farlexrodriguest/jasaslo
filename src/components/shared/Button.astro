---
/**
 * Button — styled action button using Tailwind utilities (no DaisyUI).
 * Props: variant (primary|secondary|ghost|outline), size (sm|md|lg), disabled, type.
 */
const variantClasses = {
  primary: 'bg-[#d4621a] text-white hover:bg-[#b8500f] focus-visible:outline-[#d4621a]',
  secondary: 'bg-[#fffaf2] text-[#3d2615] hover:bg-[#dfcdb8] focus-visible:outline-[#624b39]',
  ghost: 'bg-transparent text-[#594332] hover:bg-[#fffaf2] focus-visible:outline-[#624b39]',
  outline: 'border border-[#dfcdb8] bg-white text-[#594332] hover:bg-[#fffaf2] focus-visible:outline-[#624b39]',
} as const;

const sizeClasses = {
  sm: 'px-3 py-1.5 text-sm',
  md: 'px-4 py-2 text-sm',
  lg: 'px-6 py-3 text-base',
} as const;

const { variant = 'primary', size = 'md', disabled = false, type = 'button' } = Astro.props;
const vClass = variantClasses[variant as keyof typeof variantClasses] ?? variantClasses.primary;
const sClass = sizeClasses[size as keyof typeof sizeClasses] ?? sizeClasses.md;
---
<button
  type={type}
  disabled={disabled}
  class={`inline-flex items-center justify-center rounded-lg font-semibold shadow-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 disabled:cursor-not-allowed disabled:opacity-50 ${vClass} ${sClass}`}
>
  <slot />
</button>
