---
/**
 * 404 — halaman tidak ditemukan.
 *
 * Mengirimkan `NotFoundBlock` (terdaftar di `blocks.ts` sebagai `not-found`)
 * dengan palet espresso/cream. Tidak ada rute statis yang terlewat: halaman
 * yang tidak ada di koleksi `pages` jatuh ke sini.
 */
import NotFoundBlock from '../components/shared/NotFoundBlock.astro';

const notFoundImage = '/images/not-found-404.svg';
---

<NotFoundBlock
  image={notFoundImage}
  eyebrow="Tidak ditemukan"
  heading="Halaman yang Anda cari tidak ada."
  message="Halaman mungkin telah dipindahkan, diubah alamatnya, atau tidak pernah ada. Coba kembali ke beranda atau cari melalui layanan."
  homeCta="← Kembali ke beranda"
  servicesCta="Lihat semua layanan"
  articlesCta="Baca semua artikel"
/>