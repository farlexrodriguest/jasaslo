---
import {getCollection} from 'astro:content';
import {relatedService} from '../../utils/services.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/shared/SiteHeader.astro';
import ArticleOthersList from '../../components/shared/ArticleOthersList.astro';
import RelatedServiceCta from '../../components/shared/RelatedServiceCta.astro';
import ArticleRelatedList from '../../components/shared/ArticleRelatedList.astro';
import BlockRenderer from '../../components/blocks/BlockRenderer.astro';
import { ui } from '../../config/ui.ts';
import { readingTime } from '../../utils/readingTime.ts';
import { articleSchema, faqFromBlocks, faqPageSchema, itemListSchema, serviceSchema } from '../../utils/schema.ts';
export async function getStaticPaths(){const articles=(await getCollection('articles')).filter((a)=>!a.data.draft);return articles.map(article=>({params:{slug:article.data.slug},props:{article}}))}
const {article}=Astro.props;
const estMinutes = readingTime(article.data.blocks);
const service=await relatedService(article.data.relatedType,article.data.relatedId);
const base = Astro.site?.href ?? Astro.url.origin;
const root = base.replace(/\/+$/, '');
const pagePath = `/artikel/${article.data.slug}/`;
const pageUrl = `${root}${pagePath}`;
// Node service terkait — @id sama dengan Article.about (…#service) agar saling terhubung.
const serviceNode = service && article.data.relatedType === 'service'
  ? serviceSchema({ base, slug: service.data.slug, title: service.data.title, description: service.data.description, image: service.data.image, serviceType: service.data.serviceGroup })
  : null;
// Resolusi artikel terkait — urutan & penyaringan sama dengan ArticleRelatedList.
const allArticles = await getCollection('articles');
const relatedById = new Map(allArticles.map((a) => [a.data.id, a]));
const relatedEntries = [...new Set(article.data.relatedArticles)]
  .filter((id) => id !== article.data.id)
  .map((id) => relatedById.get(id))
  .filter((entry): entry is NonNullable<typeof entry> => !!entry && !entry.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const faqItems = faqFromBlocks(article.data.blocks);
const jsonLd = [
  articleSchema({
    base,
    path: pagePath,
    title: article.data.title,
    description: article.data.description,
    image: article.data.image,
    pubDate: article.data.pubDate,
    updatedDate: article.data.updatedDate,
    author: article.data.author,
    articleSection: article.data.category,
    about: serviceNode ? { url: `${root}/layanan/${service.data.slug}/` } : undefined,
  }),
  ...(serviceNode ? [serviceNode] : []),
  ...(relatedEntries.length
    ? [itemListSchema({
        base,
        path: pagePath,
        name: 'Artikel terkait',
        items: relatedEntries.map((a) => ({ name: a.data.title, url: `${root}/artikel/${a.data.slug}/` })),
      })]
    : []),
  ...(faqItems.length ? [faqPageSchema({ base, path: pagePath, items: faqItems })] : []),
];
---
<BaseLayout title={article.data.title} description={article.data.description} serviceTitle={service?.data.title} jsonLd={jsonLd} mainEntityId={`${pageUrl}#article`} pubDate={article.data.pubDate} updatedDate={article.data.updatedDate}>
<SiteHeader/>
<main id="main-content">
<section id="utama" class="border-b border-[#dfcdb8] bg-[#2a1a0e] text-[#fef3e2]">
<div class:list={["mx-auto max-w-[1440px] px-6 py-20 lg:px-12 lg:py-28", article.data.image && "grid items-center gap-10 lg:grid-cols-[1.05fr_0.95fr]"]}>
<div>
<a href="/artikel/" class="eyebrow text-[#f4ae52] hover:underline">← Kembali ke pustaka</a>
{article.data.category&&<p class="eyebrow mt-16 text-[#f4ae52]">Artikel / {article.data.category}</p>}
<h1 class="mt-6 text-[clamp(2.8rem,6vw,6rem)] font-extrabold leading-[1.04]">{article.data.title}</h1>
<p class="mt-8 max-w-2xl text-lg leading-8 text-[#e0cbb9]">{article.data.description}</p>
</div>
{article.data.image && <img src={article.data.image} alt={article.data.imageAlt || article.data.title} width="1200" height="760" fetchpriority="high" class="mx-auto w-full max-w-xl rounded-2xl border border-[#594332] lg:max-w-none" />}
</div>
</section>
<section id="isi" class="mx-auto max-w-[1440px] px-6 py-20 lg:px-12 lg:py-28">
<div class="grid gap-14 lg:grid-cols-[.3fr_.7fr]">
<aside class="border-t border-[#2a1a0e] pt-5 lg:sticky lg:top-24 lg:self-start"><p class="eyebrow text-[#a34a17]">Artikel / Pengetahuan</p>{article.data.updatedDate&&<p class="mt-4 text-sm text-[#624b39]">{ui.article.updatedLabel} {article.data.updatedDate.toLocaleDateString(ui.locale,{year:'numeric',month:'long',day:'numeric',timeZone:'Asia/Jakarta'})}</p>}<p class="mt-1 text-sm text-[#624b39]">Estimasi baca: {estMinutes} menit</p>{article.data.author&&<p class="mt-1 text-sm font-semibold text-[#2a1a0e]">{article.data.author}</p>}<div class="mt-10 hidden lg:block"><ArticleOthersList excludeSlug={article.data.slug} /></div></aside>
<article class="min-w-0">
{article.data.blocks.map((block) => <BlockRenderer block={block} />)}
<RelatedServiceCta service={service} sourceTitle={article.data.title} /><div class="mt-20 border-t border-[#dfcdb8] pt-7"><a href="/artikel/" class="font-bold text-[#a34a17]">← Semua artikel</a></div>
{article.data.relatedArticles.length > 0 && <ArticleRelatedList articleId={article.data.id} relatedIds={article.data.relatedArticles} />}
</article>
</div></section>
</main>
</BaseLayout>
