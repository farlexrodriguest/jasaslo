---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/shared/SiteHeader.astro';
import HomeLatestBlock from '../../components/shared/HomeLatestBlock.astro';
import { collectionPageSchema, itemListSchema } from '../../utils/schema.ts';
const services=(await getCollection('services')).filter((s)=>!s.data.draft&&s.data.status==='active').sort((a,b)=>a.data.order-b.data.order);
const base = Astro.site?.href ?? Astro.url.origin;
const root = base.replace(/\/+$/, '');
// CollectionPage + ItemList dirakit sebagai node terpisah agar keduanya
// terdeteksi validator; terhubung lewat mainEntity → …#itemlist.
const jsonLd = [
  collectionPageSchema({
    base,
    path: '/layanan/',
    title: 'Layanan',
    description: 'Daftar informasi layanan terkait SLO dan NIDI.',
    hasItems: services.length > 0,
  }),
  ...(services.length
    ? [itemListSchema({
        base,
        path: '/layanan/',
        items: services.map((s) => ({ name: s.data.title, url: `${root}/layanan/${s.data.slug}/` })),
      })]
    : []),
];
---
<BaseLayout title="Layanan" description="Daftar informasi layanan terkait SLO dan NIDI." jsonLd={jsonLd}>
<SiteHeader/><main id="main-content" class="mx-auto max-w-[1440px] px-6 py-20 lg:px-12 lg:py-28">
<p class="eyebrow text-[#a34a17]">Direktori / Layanan</p><h1 class="mt-5 text-6xl font-extrabold md:text-8xl">Temukan jalurnya.</h1><p class="mt-7 max-w-2xl text-lg leading-8 text-[#624b39]">Mulai dengan jenis instalasi atau dokumen yang ingin Anda pahami. Ketersediaan pendampingan dan kewenangan teknis perlu dikonfirmasi sebelum pengajuan.</p>
<div class="mt-16 border-t border-[#2a1a0e]">{services.map((s,i)=><a href={`/layanan/${s.data.slug}/`} class="group grid gap-5 border-b border-[#dfcdb8] py-8 md:grid-cols-[5rem_12rem_1fr_3rem] md:items-center"><span class="eyebrow text-[#a34a17]">{String(i+1).padStart(2,'0')}</span>{s.data.image && <img src={s.data.image} alt={s.data.imageAlt || s.data.title} width="1200" height="760" loading="lazy" class="aspect-[6/4] w-full object-cover" />}<div><h2 class="text-3xl font-bold group-hover:text-[#d4621a] md:text-5xl">{s.data.title}</h2><p class="mt-3 text-[#624b39]">{s.data.description}</p></div><span class="text-3xl">↗</span></a>)}</div>
<HomeLatestBlock id="terbaru" eyebrow="Pustaka / Bacaan terbaru" heading="Lanjutan dari pustaka." description="Bacaan berikutnya yang paling baru diperbarui — artikel dan panduan." ctaLabel="Lihat semua artikel" ctaHref="/artikel/" limit={3} offset={3} />
</main></BaseLayout>
