---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/shared/SiteHeader.astro';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';

const home = await getEntry('pages', 'home');
if (!home) throw new Error('Konten beranda tidak ditemukan (src/content/pages/home.md).');
if (home.data.draft) throw new Error('Halaman "home" ditandai draft tetapi memiliki route statis.');
// Organization, WebSite, WebPage, dan BreadcrumbList dirakit BaseLayout
// untuk setiap halaman — beranda tidak perlu merakit JSON-LD sendiri.
---
<BaseLayout title={home.data.title} description={home.data.description} pubDate={home.data.pubDate} updatedDate={home.data.updatedDate}>
<SiteHeader />
<main id="main-content">{home.data.blocks.map((block) => <BlockRenderer block={block} />)}</main>
</BaseLayout>
