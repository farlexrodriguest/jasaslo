---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/shared/SiteHeader.astro';
import GuideListBlock from '../../components/shared/GuideListBlock.astro';
import HomeLatestBlock from '../../components/shared/HomeLatestBlock.astro';
import { collectionPageSchema, itemListSchema } from '../../utils/schema.ts';

const base = Astro.site?.href ?? Astro.url.origin;
const root = base.replace(/\/+$/, '');
const guides = (await getCollection('pages')).filter((p) => !p.data.draft && p.data.section === 'panduan');
// CollectionPage + ItemList dirakit sebagai node terpisah agar keduanya
// terdeteksi validator; terhubung lewat mainEntity → …#itemlist.
const jsonLd = [
  collectionPageSchema({
    base,
    path: '/panduan/',
    title: 'Panduan',
    description: 'Panduan lengkap untuk memahami regulasi, tahapan, dan dokumen yang diperlukan dalam proses pengurusan SLO dan NIDI.',
    hasItems: guides.length > 0,
  }),
  ...(guides.length
    ? [itemListSchema({
        base,
        path: '/panduan/',
        items: guides.map((p) => ({ name: p.data.title, url: `${root}/panduan/${p.data.slug}/` })),
      })]
    : []),
];
---
<BaseLayout title="Panduan" description="Panduan lengkap untuk memahami regulasi, tahapan, dan dokumen yang diperlukan dalam proses pengurusan SLO dan NIDI." jsonLd={jsonLd}>
  <SiteHeader />
  <main id="main-content" class="mx-auto max-w-[1440px] px-6 py-20 lg:px-12 lg:py-28">
    <p class="eyebrow text-[#a34a17]">Pusat informasi / Panduan</p>
    <h1 class="mt-5 text-5xl font-extrabold md:text-7xl">Panduan regulasi dan proses.</h1>
    <p class="mt-7 max-w-2xl text-lg leading-8 text-[#624b39]">Pelajari regulasi, tahapan, dan dokumen yang diperlukan dalam proses pengurusan SLO dan NIDI.</p>
    <GuideListBlock id="daftar-panduan" heading="Panduan terbaru" description="Diurutkan dari pembaruan terakhir." />
    <HomeLatestBlock id="terbaru" eyebrow="Pustaka / Artikel pilihan" heading="Artikel ketenagalistrikan." description="Penjelasan teknis dan regulasi untuk melengkapi pemahaman Anda." ctaLabel="Lihat semua artikel" ctaHref="/artikel/" limit={3} offset={6} />
  </main>
</BaseLayout>
