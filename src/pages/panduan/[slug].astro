---
import { getCollection, render } from 'astro:content';
import { relatedService } from '../../utils/services.ts';
import PageLayout from '../../components/shared/PageLayout.astro';
import BlockRenderer from '../../components/blocks/BlockRenderer.astro';
import RelatedServiceCta from '../../components/shared/RelatedServiceCta.astro';
import { articleSchema, faqFromBlocks, faqPageSchema, serviceSchema } from '../../utils/schema.ts';

export async function getStaticPaths() {
  const pages = (await getCollection('pages'))
    .filter((page) => !page.data.draft && page.data.section === 'panduan')
    .sort((a, b) => a.data.order - b.data.order);
  return pages.map((page) => ({ params: { slug: page.data.slug }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
// Satu resolusi dipakai bersama oleh tagline footer dan CTA layanan agar sejalan.
const service = await relatedService(page.data.relatedType, page.data.relatedId);
const base = Astro.site?.href ?? Astro.url.origin;
const root = base.replace(/\/+$/, '');
const pagePath = `/panduan/${page.data.slug}/`;
const pageUrl = `${root}${pagePath}`;
// Node service terkait — @id sama dengan Article.about (…#service) agar saling terhubung.
const serviceNode = service && page.data.relatedType === 'service'
  ? serviceSchema({ base, slug: service.data.slug, title: service.data.title, description: service.data.description, image: service.data.image, serviceType: service.data.serviceGroup })
  : null;
// Semua panduan memakai blok `faq` → dirakit menjadi FAQPage.
const faqItems = faqFromBlocks(page.data.blocks);
const jsonLd = [
  articleSchema({
    base,
    path: pagePath,
    title: page.data.title,
    description: page.data.description,
    image: page.data.image,
    pubDate: page.data.pubDate,
    updatedDate: page.data.updatedDate,
    articleSection: 'Panduan',
    about: serviceNode ? { url: `${root}/layanan/${service.data.slug}/` } : undefined,
  }),
  ...(serviceNode ? [serviceNode] : []),
  ...(faqItems.length ? [faqPageSchema({ base, path: pagePath, items: faqItems })] : []),
];
---
<PageLayout page={page.data} serviceTitle={service?.data.title} othersList pubDate={page.data.pubDate} updatedDate={page.data.updatedDate} jsonLd={jsonLd} mainEntityId={`${pageUrl}#article`}>
  {page.data.blocks.map((block) => <BlockRenderer block={block} />)}
  <div class="page-markdown mt-8"><Content /></div>
  <RelatedServiceCta service={service} sourceTitle={page.data.title} sourceLabel="panduan" />
</PageLayout>
